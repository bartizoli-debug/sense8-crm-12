# Copy this file to .env.local to run the CRM against the in-memory database
# in lib/mock instead of Supabase:
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored, so each developer keeps their own copy.

# Use the in-memory database instead of Supabase.
# Set to false to use the real Supabase project configured in .env.
NEXT_PUBLIC_USE_MOCK_DB=true

# Start already signed in as the demo user.
# Set to false to land on /login instead — any email/password is accepted.
NEXT_PUBLIC_MOCK_AUTOLOGIN=true

# Role claim on the demo session. admin / editor / manager / sales unlock the
# deal editor; anything else makes deals read-only.
NEXT_PUBLIC_MOCK_ROLE=admin
